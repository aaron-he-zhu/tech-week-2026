{
  "singleQuote": true,
  "printWidth": 100,
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": "templates/*.html",
      "options": {
        "printWidth": 10000,
        "htmlWhitespaceSensitivity": "strict"
      }
    },
    {
      "files": "**/*.jsonc",
      "options": {
        "parser": "json"
      }
    }
  ]
}
